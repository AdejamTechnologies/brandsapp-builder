{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "types": ["@cloudflare/workers-types", "vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@brandsapp/builder-core": ["../brandsapp-multitenant/lib/builder-core"]
    }
  },
  "include": ["src", "worker", "vite.config.ts", "*.d.ts"]
}
