{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brandsapp-builder",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "durable_objects": {
    "bindings": [{ "name": "DOC_ROOM", "class_name": "DocRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocRoom"] }],
  "observability": { "enabled": true },
  "vars": {
    // Brands live at https://<slug>.<TENANT_HOST_SUFFIX>. The client names a
    // brand by SLUG and this address is built here, on the server — `?tenant=`
    // used to be a full URL from the query string, which meant anyone could
    // edit any brand and could also have the fleet service token posted to a
    // server of their choosing.
    "TENANT_HOST_SUFFIX": "brandsapp.io",
    // Local development against a tenant on localhost. Honoured ONLY when
    // ALLOW_LOCAL_TENANT is "1", which must never be true in production.
    "TENANT_API_BASE": "",
    "ALLOW_LOCAL_TENANT": "0",
    // Both secrets: `wrangler secret put <name>`
    //   BUILDER_SERVICE_TOKEN — calls a tenant's builder API. Opens every brand.
    //   BUILDER_GRANT_SECRET  — signs/verifies who may open the builder, shared
    //                           with the platform. Separate from the above, so a
    //                           leaked signing key cannot be replayed at a tenant.
  },
}
